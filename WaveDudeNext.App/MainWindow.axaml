<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docking="using:WaveDudeNext.App.Docking"
        xmlns:layout="using:WaveDudeNext.UI.Docking"
        xmlns:panes="using:WaveDudeNext.App.Panes"
        x:Class="WaveDudeNext.App.MainWindow"
        Title="WaveDude Next"
        Icon="/Assets/wavedudenext.ico"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontSize="12"
        DragDrop.AllowDrop="True">
	<!-- The window as the WPF one lays it out: the menu bar, the dock host with the Project, Properties and Messages panes
	     around the Preview document, and the status bar. The menus are Mark's markup and carry their texts from the string
	     table through DynamicResource, so a language switch applies at once; their commands come with the models (the
	     next step), as do the panes' bindings. The items a harness reads carry the WPF head's automation ids. -->
	<DockPanel>
		<Menu x:Name="menu" DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}" Foreground="{DynamicResource MenuForeground}">
			<MenuItem Header="{DynamicResource MenuFile}">
				<MenuItem x:Name="mnuNew" Header="{DynamicResource MenuFileNew}" InputGesture="Ctrl+N" />
				<MenuItem x:Name="mnuOpen" Header="{DynamicResource MenuFileOpen}" InputGesture="Ctrl+O" />
				<MenuItem x:Name="mnuRecent" Header="{DynamicResource MenuFileRecent}" />
				<MenuItem x:Name="mnuExamples" Header="{DynamicResource MenuFileExamples}" AutomationProperties.AutomationId="MenuExamples" />
				<Separator />
				<MenuItem x:Name="mnuSave" Header="{DynamicResource MenuFileSave}" InputGesture="Ctrl+S" />
				<MenuItem x:Name="mnuSaveAs" Header="{DynamicResource MenuFileSaveAs}" InputGesture="Ctrl+Shift+S" />
				<Separator />
				<MenuItem x:Name="mnuExport" Header="{DynamicResource MenuFileExport}" AutomationProperties.AutomationId="MenuExport">
					<MenuItem x:Name="mnuExportField" Header="{DynamicResource MenuFileExportField}" InputGesture="Ctrl+Shift+E" />
					<MenuItem x:Name="mnuExportIntensity" Header="{DynamicResource MenuFileExportIntensity}" InputGesture="Ctrl+Shift+I" />
					<MenuItem x:Name="mnuExportBoth" Header="{DynamicResource MenuFileExportBoth}" InputGesture="Ctrl+Shift+B" />
					<Separator />
					<MenuItem x:Name="mnuExportFieldFrame" Header="{DynamicResource MenuFileExportFieldFrame}" InputGesture="Ctrl+Shift+F" />
					<MenuItem x:Name="mnuExportIntensityFrame" Header="{DynamicResource MenuFileExportIntensityFrame}" InputGesture="Ctrl+Shift+G" />
				</MenuItem>
				<MenuItem x:Name="mnuExportLast" Header="{DynamicResource MenuFileExportLast}" InputGesture="Ctrl+E" AutomationProperties.AutomationId="MenuExportLast" />
				<Separator />
				<MenuItem x:Name="mnuClose" Header="{DynamicResource MenuFileClose}" />
				<MenuItem x:Name="mnuExit" Header="{DynamicResource MenuFileExit}" InputGesture="Alt+F4" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuEdit}">
				<MenuItem x:Name="mnuUndo" Header="{DynamicResource MenuEditUndo}" InputGesture="Ctrl+Z" />
				<MenuItem x:Name="mnuRedo" Header="{DynamicResource MenuEditRedo}" InputGesture="Ctrl+Y" />
				<Separator />
				<MenuItem x:Name="mnuCut" Header="{DynamicResource MenuEditCut}" InputGesture="Ctrl+X" />
				<MenuItem x:Name="mnuCopy" Header="{DynamicResource MenuEditCopy}" InputGesture="Ctrl+C" />
				<MenuItem x:Name="mnuPaste" Header="{DynamicResource MenuEditPaste}" InputGesture="Ctrl+V" />
				<MenuItem x:Name="mnuDelete" Header="{DynamicResource MenuEditDelete}" InputGesture="Delete" />
				<Separator />
				<MenuItem x:Name="mnuSelectAll" Header="{DynamicResource MenuProjectSelectAll}" InputGesture="Ctrl+A" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuView}">
				<MenuItem x:Name="mnuPanes" Header="{DynamicResource MenuViewPanes}" />
				<MenuItem x:Name="mnuTheme" Header="{DynamicResource MenuViewTheme}" />
				<MenuItem x:Name="mnuUiZoom" Header="{DynamicResource MenuViewUiZoom}" />
				<MenuItem x:Name="mnuLanguage" Header="{DynamicResource MenuViewLanguage}" />
				<Separator />
				<MenuItem x:Name="mnuResolution" Header="{DynamicResource MenuViewResolution}" />
				<MenuItem x:Name="mnuFrames" Header="{DynamicResource MenuViewFrames}" />
				<MenuItem x:Name="mnuSamples" Header="{DynamicResource MenuViewSamples}" />
				<MenuItem x:Name="mnuDither" Header="{DynamicResource MenuViewDither}" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuSimulation}">
				<MenuItem x:Name="mnuRun" Header="{DynamicResource MenuSimulationRun}" InputGesture="F5" />
				<MenuItem x:Name="mnuTogglePause" Header="{DynamicResource MenuSimulationPause}" InputGesture="F6" />
				<MenuItem x:Name="mnuStop" Header="{DynamicResource MenuSimulationStop}" InputGesture="Shift+F5" />
				<MenuItem x:Name="mnuPlayPause" Header="{DynamicResource MenuSimulationPlay}" InputGesture="F7" />
				<Separator />
				<MenuItem x:Name="mnuUseGpu" Header="{DynamicResource MenuSimulationUseGpu}" ToggleType="CheckBox" />
				<MenuItem x:Name="mnuAutoRerun" Header="{DynamicResource MenuSimulationAutoRerun}" ToggleType="CheckBox" />
				<MenuItem x:Name="mnuWarnMemory" Header="{DynamicResource MenuSimulationWarnMemory}" ToggleType="CheckBox" />
				<MenuItem x:Name="mnuFrameMemory" Header="{DynamicResource MenuSimulationFrameMemory}" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuHelp}">
				<MenuItem x:Name="mnuAbout" Header="{DynamicResource MenuHelpAbout}" />
				<MenuItem x:Name="mnuManual" Header="{DynamicResource MenuHelpManual}" InputGesture="F1" />
			</MenuItem>
		</Menu>

		<!-- the status bar: the last log line (double-click opens the Messages pane), the run's state, the export's progress -->
		<Border x:Name="statusBar" DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}" MinHeight="22" Padding="4,0,16,0">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<TextBlock x:Name="txtExport" AutomationProperties.AutomationId="StatusExport" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center" Margin="4,2" />
					<ProgressBar x:Name="exportProgress" Width="120" Height="12" IsVisible="False" />
					<TextBlock x:Name="txtRun" AutomationProperties.AutomationId="StatusRun" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center" Margin="4,2" />
				</StackPanel>
				<TextBlock x:Name="txtStatus" AutomationProperties.AutomationId="StatusMessage" Text="{DynamicResource Ready}" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center" Margin="4,2" TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>

		<docking:DockHost x:Name="dockHost">
			<!-- the arrangement of a first start (agreed 2026-10-09): a left column of a quarter of the width with the Project
			     tree in its upper third and the Properties pane below it, the preview in the rest; Messages hidden. Loaded by
			     the window when no saved layout applies -->
			<docking:DockHost.DefaultLayout>
				<layout:DockLayout>
					<layout:DockLayout.Root>
						<layout:SplitLayout Orientation="Horizontal">
							<layout:SplitLayout.Children>
								<layout:SplitLayout Orientation="Vertical" Length="1">
									<layout:SplitLayout.Children>
										<layout:GroupLayout Active="project" Length="1">
											<layout:GroupLayout.Items><x:String>project</x:String></layout:GroupLayout.Items>
										</layout:GroupLayout>
										<layout:GroupLayout Active="properties" Length="2">
											<layout:GroupLayout.Items><x:String>properties</x:String></layout:GroupLayout.Items>
										</layout:GroupLayout>
									</layout:SplitLayout.Children>
								</layout:SplitLayout>
								<layout:DocumentLayout Length="3" />
							</layout:SplitLayout.Children>
						</layout:SplitLayout>
					</layout:DockLayout.Root>
				</layout:DockLayout>
			</docking:DockHost.DefaultLayout>
			<docking:DockHost.Items>
				<docking:DockItem Id="project" Title="{StaticResource PaneProject}" DefaultSide="Left">
					<panes:ProjectTree x:Name="projectTree" />
				</docking:DockItem>
				<docking:DockItem Id="properties" Title="{StaticResource PaneProperties}" DefaultSide="Right">
					<panes:PropertiesPane x:Name="propertiesPane" />
				</docking:DockItem>
				<docking:DockItem Id="messages" Title="{StaticResource PaneMessages}" DefaultSide="Bottom">
					<panes:MessagesPane x:Name="messagesPane" />
				</docking:DockItem>
			</docking:DockHost.Items>
			<docking:DockHost.DocumentContent>
				<Border BorderThickness="1" BorderBrush="{DynamicResource ToolWindowBorder}">
					<panes:PreviewPane x:Name="previewPane" />
				</Border>
			</docking:DockHost.DocumentContent>
		</docking:DockHost>
	</DockPanel>
</Window>
