<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.PartPointsView"
             x:DataType="model:OutlinePart">
	<!-- the point list of a polygon outline (the data context is the part): one row per point with X and Y relative to
	     the centre, before rotation, a remove button, and an add button below -->
	<StackPanel>
		<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionPoints}" />
		<TextBlock Classes="FormHint" Text="{Binding $parent[views:PartPointsView].HintText}" />
		<DockPanel Margin="0,0,0,2">
			<Border DockPanel.Dock="Right" Width="22" />
			<UniformGrid Columns="2">
				<TextBlock Classes="FormLabel" Text="{meta:Label model:PartPoint.X}" Margin="2,0" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:PartPoint.Y}" Margin="2,0" />
			</UniformGrid>
		</DockPanel>
		<ItemsControl x:Name="list" ItemsSource="{Binding Points}" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="model:PartPoint">
					<DockPanel Margin="0,0,0,4">
						<Button DockPanel.Dock="Right" Theme="{DynamicResource RemovePointButton}" ToolTip.Tip="{DynamicResource TipRemovePoint}"
						        AutomationProperties.Name="{DynamicResource TipRemovePoint}" Click="OnRemovePoint" />
						<UniformGrid Columns="2">
							<controls:NumberBox Margin="0,0,2,0" Text="{Binding X, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{DynamicResource Hint.PartPoint.X}" />
							<controls:NumberBox Margin="2,0,0,0" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{DynamicResource Hint.PartPoint.Y}" />
						</UniformGrid>
					</DockPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddPoint}" ToolTip.Tip="{DynamicResource TipAddPoint}"
			        Click="OnAddPoint" AutomationProperties.AutomationId="PartAddPoint" />
		</StackPanel>
	</StackPanel>
</UserControl>
