<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.TrianglePartView"
             x:DataType="model:TrianglePart">
	<UserControl.Resources>
		<converters:TriangleApexConverter x:Key="ApexAngle" />
		<converters:EnumOneOfConverter x:Key="EnumOneOf" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:TrianglePart.Type}" />
				<ComboBox Theme="{DynamicResource EnumComboBox}" ItemsSource="{meta:EnumValues model:TriangleType}"
				          SelectedItem="{Binding Type}" ToolTip.Tip="{meta:Hint model:TrianglePart.Type}" AutomationProperties.AutomationId="PartTriangleType" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:TrianglePart.Base}" />
				<controls:NumberBox Text="{Binding Base, UpdateSourceTrigger=LostFocus}" Minimum="2" Increment="10" ToolTip.Tip="{meta:Hint model:TrianglePart.Base}" AutomationProperties.AutomationId="PartBase" />

				<!-- the presets fix the angles: A is typed for the isosceles and custom types, B for custom only -->
				<TextBlock Classes="FormLabel" Text="{meta:Label model:TrianglePart.AngleA}" />
				<controls:NumberBox Text="{Binding AngleA, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="178" DragStep="0.5" Decimals="1"
				                    IsEnabled="{Binding Type, Converter={StaticResource EnumOneOf}, ConverterParameter='Isosceles,Custom'}"
				                    ToolTip.Tip="{meta:Hint model:TrianglePart.AngleA}" AutomationProperties.AutomationId="PartAngleA" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:TrianglePart.AngleB}" />
				<controls:NumberBox Text="{Binding AngleB, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="178" DragStep="0.5" Decimals="1"
				                    IsEnabled="{Binding Type, Converter={StaticResource EnumOneOf}, ConverterParameter=Custom}"
				                    ToolTip.Tip="{meta:Hint model:TrianglePart.AngleB}" AutomationProperties.AutomationId="PartAngleB" />

				<!-- read-only: what the two base angles leave for the apex -->
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelApexAngle}" />
				<TextBlock Classes="FormReadout" ToolTip.Tip="{DynamicResource TipApexAngle}" AutomationProperties.AutomationId="PartApexAngle">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource ApexAngle}">
							<Binding Path="Type" />
							<Binding Path="AngleA" />
							<Binding Path="AngleB" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
