<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:WaveDudeNext.App.Localization"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:app="using:WaveDudeNext.App"
             x:Class="WaveDudeNext.App.Views.CollectionView"
             x:DataType="app:NamedCollection">
	<UserControl.Resources>
		<converters:ItemCountConverter x:Key="ItemCount" />
	</UserControl.Resources>

	<!-- a folder node (Sources, Probes): just the name and the count, the count with its plural -->
	<StackPanel Margin="8">
		<Label Theme="{DynamicResource FormSection}" Content="{Binding Label}" Margin="0,2,0,4" />
		<TextBlock Classes="FormValue" Margin="0" AutomationProperties.AutomationId="CollectionCount">
			<TextBlock.Text>
				<!-- the language, so "n items" follows a switch at once (upstream CollectionView.xaml:36) -->
				<MultiBinding Converter="{StaticResource ItemCount}">
					<Binding Path="Items.Count" />
					<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
				</MultiBinding>
			</TextBlock.Text>
		</TextBlock>
	</StackPanel>
</UserControl>
