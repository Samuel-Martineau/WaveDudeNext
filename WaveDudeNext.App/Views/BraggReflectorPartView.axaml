<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.BraggReflectorPartView"
             x:DataType="model:BraggReflectorPart">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionLayers}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Pairs}" />
				<controls:NumberBox Text="{Binding Pairs, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="200" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Pairs}" AutomationProperties.AutomationId="PartPairs" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Thickness1}" />
				<controls:NumberBox Text="{Binding Thickness1, UpdateSourceTrigger=LostFocus}" Minimum="1" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Thickness1}" AutomationProperties.AutomationId="PartThickness1" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Index1}" />
				<controls:NumberBox Text="{Binding Index1, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Index1}" AutomationProperties.AutomationId="PartIndex1" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Thickness2}" />
				<controls:NumberBox Text="{Binding Thickness2, UpdateSourceTrigger=LostFocus}" Minimum="1" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Thickness2}" AutomationProperties.AutomationId="PartThickness2" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Index2}" />
				<controls:NumberBox Text="{Binding Index2, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Index2}" AutomationProperties.AutomationId="PartIndex2" />
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:BraggReflectorPart.Width}" />
				<controls:NumberBox Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Minimum="2" Increment="10" ToolTip.Tip="{meta:Hint model:BraggReflectorPart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
