<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.RectanglePartView"
             x:DataType="model:RectanglePart">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<!-- the two sizes with the chain beside them spanning both rows, as the image editors draw it; one row of the
				     form, laid out to the form's label column (the code-behind sets the first column to the panel's LabelWidth) -->
				<Grid x:Name="sizeGrid" controls:FormPanel.FullWidth="True" ColumnDefinitions="110,8,*,Auto" RowDefinitions="Auto,4,Auto">
					<TextBlock Classes="FormLabel" Text="{meta:Label model:RectanglePart.Length}" />
					<controls:NumberBox Grid.Column="2" Text="{Binding Length, UpdateSourceTrigger=LostFocus}" Minimum="1" Increment="10"
					                    ToolTip.Tip="{meta:Hint model:RectanglePart.Length}" AutomationProperties.AutomationId="PartLength" />
					<TextBlock Grid.Row="2" Classes="FormLabel" Text="{meta:Label model:RectanglePart.Width}" />
					<controls:NumberBox Grid.Row="2" Grid.Column="2" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Minimum="1" Increment="10"
					                    ToolTip.Tip="{meta:Hint model:RectanglePart.Width}" AutomationProperties.AutomationId="PartWidth" />
					<ToggleButton Grid.Column="3" Grid.RowSpan="3" Theme="{DynamicResource LinkToggle}" Margin="4,0,0,0" VerticalAlignment="Center"
					              IsChecked="{Binding Linked}" ToolTip.Tip="{meta:Hint model:RectanglePart.Linked}"
					              AutomationProperties.Name="{meta:Label model:RectanglePart.Linked}" AutomationProperties.AutomationId="PartLinked" />
				</Grid>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
