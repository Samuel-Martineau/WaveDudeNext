<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:WaveDudeNext.App.Localization"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.LogicGatePartView"
             x:DataType="model:LogicGatePart">
	<UserControl.Resources>
		<converters:LogicGateLayoutConverter x:Key="Layout" />
		<converters:EnumNameConverter x:Key="EnumName" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionDesign}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.DesignFrequency}" />
				<controls:NumberBox Text="{Binding DesignFrequency, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="255" DragStep="0.1" Decimals="2"
				                    ToolTip.Tip="{meta:Hint model:LogicGatePart.DesignFrequency}" AutomationProperties.AutomationId="PartDesignFrequency" />

				<!-- read-only: the wavelength the frequency gives with the project's frequency scale -->
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelWavelength}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartWavelength" ToolTip.Tip="{DynamicResource TipGateWavelength}">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="Wavelength">
							<Binding />
							<Binding Path="Wavelength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionMaterial}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.CoreIndex}" />
				<controls:NumberBox Text="{Binding CoreIndex, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{meta:Hint model:LogicGatePart.CoreIndex}" AutomationProperties.AutomationId="PartCoreIndex" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.CladdingIndex}" />
				<controls:NumberBox Text="{Binding CladdingIndex, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{meta:Hint model:LogicGatePart.CladdingIndex}" AutomationProperties.AutomationId="PartCladdingIndex" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.Coating}" />
				<controls:NumberBox Text="{Binding Coating, UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="50" ToolTip.Tip="{meta:Hint model:LogicGatePart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<!-- per end, so a junction between staggered gates can go without a band -->
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:LogicGatePart.InputCoated}"
				          IsChecked="{Binding InputCoated}" ToolTip.Tip="{meta:Hint model:LogicGatePart.InputCoated}" AutomationProperties.AutomationId="PartInputCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:LogicGatePart.OutputCoated}"
				          IsChecked="{Binding OutputCoated}" ToolTip.Tip="{meta:Hint model:LogicGatePart.OutputCoated}" AutomationProperties.AutomationId="PartOutputCoated" />

				<!-- read-only: the quarter-wave thickness for the core, the least reflecting band -->
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelQuarterWave}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartQuarterWave" ToolTip.Tip="{DynamicResource TipQuarterWave}">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="QuarterWave">
							<Binding />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.PortSpacing}" />
				<!-- the spacing the design uses, so each step moves the ports; a value below the minimum springs back to it -->
				<controls:NumberBox Text="{Binding PortSpacingUsed, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="2000" Increment="2"
				                    ToolTip.Tip="{meta:Hint model:LogicGatePart.PortSpacing}" AutomationProperties.AutomationId="PartPortSpacing" />
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionOutputs}" />
			<controls:FormPanel>
				<!-- each output by its place, ticked to let its light out; the box names what the output gives for this kind of gate -->
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.UpperOutputActive}" />
				<CheckBox IsChecked="{Binding UpperOutputActive}"
				          ToolTip.Tip="{meta:Hint model:LogicGatePart.UpperOutputActive}" AutomationProperties.AutomationId="PartUpperOutputActive">
					<CheckBox.Content>
						<MultiBinding Converter="{StaticResource EnumName}">
							<Binding Path="UpperOutput" />
							<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
						</MultiBinding>
					</CheckBox.Content>
				</CheckBox>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.LowerOutputActive}" />
				<CheckBox IsChecked="{Binding LowerOutputActive}"
				          ToolTip.Tip="{meta:Hint model:LogicGatePart.LowerOutputActive}" AutomationProperties.AutomationId="PartLowerOutputActive">
					<CheckBox.Content>
						<MultiBinding Converter="{StaticResource EnumName}">
							<Binding Path="LowerOutput" />
							<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
						</MultiBinding>
					</CheckBox.Content>
				</CheckBox>
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionLayout}" />
			<controls:FormPanel ToolTip.Tip="{DynamicResource TipGateLayout}">
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelCoreWidth}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartCoreWidth">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="CoreWidth">
							<Binding />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelCouplerGap}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartCouplerGap">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="Gap">
							<Binding />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelCouplerLength}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartCouplerLength">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="CouplerLength">
							<Binding />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelGateLength}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartGateLength">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="Length">
							<Binding />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionPorts}" />
			<controls:FormPanel ToolTip.Tip="{DynamicResource TipGatePorts}">
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelInputA}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartInputA">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="InputA">
							<Binding />
							<Binding Path="X" />
							<Binding Path="Y" />
							<Binding Path="Angle" />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelInputB}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartInputB">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="InputB">
							<Binding />
							<Binding Path="X" />
							<Binding Path="Y" />
							<Binding Path="Angle" />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.UpperOutputActive}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartOutputUpper">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="OutputUpper">
							<Binding />
							<Binding Path="X" />
							<Binding Path="Y" />
							<Binding Path="Angle" />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:LogicGatePart.LowerOutputActive}" />
				<TextBlock Classes="FormReadout" AutomationProperties.AutomationId="PartOutputLower">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Layout}" ConverterParameter="OutputLower">
							<Binding />
							<Binding Path="X" />
							<Binding Path="Y" />
							<Binding Path="Angle" />
							<Binding Path="Wavelength" />
							<Binding Path="CoreIndex" />
							<Binding Path="CladdingIndex" />
							<Binding Path="PortSpacing" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
