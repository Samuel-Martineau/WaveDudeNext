<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             x:Class="WaveDudeNext.App.Views.SimulationView"
             x:DataType="model:Simulation">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionRun}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.Steps}" />
				<controls:NumberBox Text="{Binding Steps, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="10000000" Increment="100"
				                    ToolTip.Tip="{meta:Hint model:Simulation.Steps}" AutomationProperties.AutomationId="SimulationSteps" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.VisualizeEvery}" />
				<controls:NumberBox Text="{Binding VisualizeEvery, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="1000"
				                    ToolTip.Tip="{meta:Hint model:Simulation.VisualizeEvery}" AutomationProperties.AutomationId="SimulationVisualizeEvery" />
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionSolver}" />
			<controls:FormPanel>
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Simulation.FourthOrderLaplacian}"
				          IsChecked="{Binding FourthOrderLaplacian}" ToolTip.Tip="{meta:Hint model:Simulation.FourthOrderLaplacian}" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.WaveSpeed}" />
				<controls:NumberBox Text="{Binding WaveSpeed, UpdateSourceTrigger=LostFocus}" Minimum="0.000001" Maximum="1000000" Increment="0.01"
				                    ToolTip.Tip="{meta:Hint model:Simulation.WaveSpeed}" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.TimeDecay}" />
				<controls:NumberBox Text="{Binding TimeDecay, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="100" DragStep="0.1" Decimals="1"
				                    ToolTip.Tip="{meta:Hint model:Simulation.TimeDecay}" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.SourceFrequencyScale}" />
				<controls:NumberBox Text="{Binding SourceFrequencyScale, UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="1000" Increment="0.1"
				                    ToolTip.Tip="{meta:Hint model:Simulation.SourceFrequencyScale}" />

				<TextBlock Classes="FormLabel" Text="{meta:Label model:Simulation.IntensityScale}" />
				<controls:NumberBox Text="{Binding IntensityScale, UpdateSourceTrigger=LostFocus}" Minimum="0.0000001" Maximum="1000000" Increment="0.1"
				                    ToolTip.Tip="{meta:Hint model:Simulation.IntensityScale}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
