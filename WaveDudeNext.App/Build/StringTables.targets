<!-- Build action: the WPF head's string tables (the StringTable items, WaveDudeNext.WPF/Strings/Strings.XX.xaml) become
     Avalonia resource dictionaries under obj/<Configuration>/Strings/ and are compiled into this assembly as
     Strings/Strings.XX.axaml (avares://WaveDudeNext.App/Strings/Strings.XX.axaml), which App.axaml merges and the
     language switch swaps. The tables hold s:String entries and nothing else, so the conversion is textual: the
     default namespace, the System namespace declaration, the string element's prefix (2026-11-09, the user's choice:
     one source for both heads, each loading a compiled dictionary; Mark's port had converted them the same way with
     a script and kept the copies). The converter is StringTables.cs beside this file, an inline C# task
     (RoslynCodeTaskFactory, part of MSBuild). A table is converted again only when it, the converter or this file is
     newer than its output; the items are added before Avalonia gathers its resources. -->
<Project>

  <UsingTask TaskName="ConvertStringTables" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)StringTables.cs" />
    </Task>
  </UsingTask>

  <PropertyGroup>
    <StringTableConverter>$(MSBuildThisFileDirectory)StringTables.cs</StringTableConverter>
  </PropertyGroup>

  <!-- the conversion into obj/<Configuration>/<Framework>/Strings/, skipped while every output is newer than its table,
       the converter and this file. The output folder is named in the targets, not in a property of this file: a property
       here is evaluated when the project imports the file, before the SDK has set IntermediateOutputPath -->
  <Target Name="ConvertStringTables"
          Inputs="@(StringTable);$(StringTableConverter);$(MSBuildThisFileFullPath)"
          Outputs="@(StringTable->'$(IntermediateOutputPath)Strings\%(Filename).axaml')">
    <ConvertStringTables Sources="@(StringTable)" Destination="$(IntermediateOutputPath)Strings\" />
  </Target>

  <!-- the converted tables as XAML of this project, under Strings/ by their Link; before Avalonia's resource gathering,
       whose first step runs before ResolveReferences -->
  <Target Name="IncludeStringTables" BeforeTargets="BeforeBuild;AddAvaloniaResources;_GenerateAvaloniaResourcesDependencyCache;_InjectAvaloniaAdditionalFiles" DependsOnTargets="ConvertStringTables">
    <ItemGroup>
      <_StringTableXaml Include="$(IntermediateOutputPath)Strings\*.axaml" />
      <AvaloniaXaml Include="@(_StringTableXaml)" Link="Strings\%(Filename)%(Extension)" />
      <FileWrites Include="@(_StringTableXaml)" />
    </ItemGroup>
  </Target>

</Project>
