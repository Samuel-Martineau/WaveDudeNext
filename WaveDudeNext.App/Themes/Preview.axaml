<!-- The preview pane's glyphs and control themes (upstream's PreviewPane.xaml resources): the transport bar's 22 x 22
     buttons and toggles with a filled Path glyph (Content is the geometry), the split radios, the probe graph box thumbs,
     the picture splitter and the busy spinner. Brushes come from the theme dictionaries through DynamicResource; the
     geometries are upstream's path data, copied. Included by the pane (UserControl.Styles). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<!-- "run": a play triangle inside a ring (the author asked for an explicit start button) -->
			<StreamGeometry x:Key="RunGeometry">M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 Z M1.4,7 A5.6,5.6 0 1 0 12.6,7 A5.6,5.6 0 1 0 1.4,7 Z M5.2,3.5 L10.8,7 L5.2,10.5 Z</StreamGeometry>
			<!-- the run's pause: the run's ring with the two bars of a pause inside -->
			<StreamGeometry x:Key="PauseRunGeometry">M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 Z M1.4,7 A5.6,5.6 0 1 0 12.6,7 A5.6,5.6 0 1 0 1.4,7 Z M4.5,4 L6.2,4 L6.2,10 L4.5,10 Z M7.8,4 L9.5,4 L9.5,10 L7.8,10 Z</StreamGeometry>
			<!-- "stop": the same ring with a square inside; the Run button shows it while a run is in progress -->
			<StreamGeometry x:Key="StopGeometry">M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 Z M1.4,7 A5.6,5.6 0 1 0 12.6,7 A5.6,5.6 0 1 0 1.4,7 Z M4.7,4.7 L9.3,4.7 L9.3,9.3 L4.7,9.3 Z</StreamGeometry>
			<!-- the two pictures: a wave for the field, a sun for the intensity -->
			<StreamGeometry x:Key="FieldGeometry">M0,6 C1.5,1 2.5,1 4,6 C5.5,11 6.5,11 8,6 C9,3 10,3 11,6 L11,7.5 C10,5 9,5 8,7.5 C6.5,12.5 5.5,12.5 4,7.5 C2.5,2.5 1.5,2.5 0,7.5 Z</StreamGeometry>
			<StreamGeometry x:Key="IntensityGeometry">M3,5 A2,2 0 1 1 7,5 A2,2 0 1 1 3,5 Z M4.4,0 L5.6,0 L5.6,2 L4.4,2 Z M4.4,8 L5.6,8 L5.6,10 L4.4,10 Z M0,4.4 L2,4.4 L2,5.6 L0,5.6 Z M8,4.4 L10,4.4 L10,5.6 L8,5.6 Z</StreamGeometry>
			<StreamGeometry x:Key="PlayGeometry">M0,0 L9,5 L0,10 Z</StreamGeometry>
			<StreamGeometry x:Key="PauseGeometry">M0,0 L3,0 L3,10 L0,10 Z M6,0 L9,0 L9,10 L6,10 Z</StreamGeometry>
			<StreamGeometry x:Key="SideBySideGeometry">M0,0 L5,0 L5,10 L0,10 Z M7,0 L12,0 L12,10 L7,10 Z</StreamGeometry>
			<StreamGeometry x:Key="StackedGeometry">M0,0 L12,0 L12,4 L0,4 Z M0,6 L12,6 L12,10 L0,10 Z</StreamGeometry>
			<!-- frame step: the triangle leaves a bar behind it (the editors' frame-step look) -->
			<StreamGeometry x:Key="StepBackGeometry">M7,0 L9,0 L9,10 L7,10 Z M0,5 L6,0 L6,10 Z</StreamGeometry>
			<StreamGeometry x:Key="StepForwardGeometry">M0,0 L2,0 L2,10 L0,10 Z M3,0 L9,5 L3,10 Z</StreamGeometry>
			<StreamGeometry x:Key="SetInGeometry">M0,0 L4,0 L4,2 L2,2 L2,8 L4,8 L4,10 L0,10 Z M6,2 L11,5 L6,8 Z</StreamGeometry>
			<StreamGeometry x:Key="SetOutGeometry">M11,0 L7,0 L7,2 L9,2 L9,8 L7,8 L7,10 L11,10 Z M5,2 L0,5 L5,8 Z</StreamGeometry>
			<StreamGeometry x:Key="ClearRangeGeometry">M0,1.5 L1.5,0 L5,3.5 L8.5,0 L10,1.5 L6.5,5 L10,8.5 L8.5,10 L5,6.5 L1.5,10 L0,8.5 L3.5,5 Z</StreamGeometry>
			<!-- "repeat": two arrows chasing each other -->
			<StreamGeometry x:Key="LoopGeometry">M1,2 L8,2 L8,0 L12,3 L8,6 L8,4 L3,4 L3,6 L1,6 Z M11,8 L4,8 L4,10 L0,7 L4,4 L4,6 L9,6 L9,4 L11,4 Z</StreamGeometry>
			<!-- "live": a dot inside a ring (even-odd fill makes the ring hollow) -->
			<StreamGeometry x:Key="LiveGeometry">M0.5,5 A4.5,4.5 0 1 1 9.5,5 A4.5,4.5 0 1 1 0.5,5 Z M1.5,5 A3.5,3.5 0 1 0 8.5,5 A3.5,3.5 0 1 0 1.5,5 Z M3.5,5 A1.5,1.5 0 1 1 6.5,5 A1.5,1.5 0 1 1 3.5,5 Z</StreamGeometry>
			<!-- the spinner over a dimmed picture while a frame computes: a three-quarter ring turning once a second -->
			<StreamGeometry x:Key="SpinnerGeometry">M18,3 A15,15 0 1 1 3,18</StreamGeometry>
			<!-- the resize grip at a graph box's bottom-right corner -->
			<StreamGeometry x:Key="ResizeGripGlyph">M11,1 L11,3 L3,11 L1,11 Z M11,6 L11,8 L8,11 L6,11 Z</StreamGeometry>

			<!-- filled-glyph transport button; Content is the geometry. A tab stop: keyboard focus shows as an accent border -->
			<ControlTheme x:Key="TransportButton" TargetType="Button">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus-visible /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:pressed /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:pressed">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- glyph toggle button; the checked one stays pressed. The toggles share the buttons' look, including the greyed,
			     half-transparent disabled state (Live without a run) -->
			<ControlTheme x:Key="TransportToggle" TargetType="ToggleButton">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus-visible /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:checked /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:checked">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- the split radios: the same look; their group is one tab stop with Left/Right inside (see the pane) -->
			<ControlTheme x:Key="TransportRadio" TargetType="RadioButton">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus-visible /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:checked /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:checked">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- a probe's graph box: the thumb covering the box (transparent; focus and hover show a border) and the resize
			     grip at its bottom-right corner. The box itself is drawn by the overlay -->
			<ControlTheme x:Key="ProbeBoxThumb" TargetType="Thumb">
				<Setter Property="Cursor" Value="SizeAll" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="#80FFFFFF" />
				</Style>
				<Style Selector="^:focus /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
					<Setter Property="BorderThickness" Value="2" />
				</Style>
			</ControlTheme>
			<ControlTheme x:Key="ProbeBoxCornerThumb" TargetType="Thumb">
				<Setter Property="Width" Value="12" />
				<Setter Property="Height" Value="12" />
				<Setter Property="Cursor" Value="BottomRightCorner" />
				<Setter Property="Foreground" Value="#A0FFFFFF" />
				<Setter Property="Template">
					<ControlTemplate>
						<Panel Background="Transparent">
							<Path Data="{StaticResource ResizeGripGlyph}" Fill="{TemplateBinding Foreground}" />
						</Panel>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:focus">
					<Setter Property="Foreground" Value="{DynamicResource Accent}" />
				</Style>
			</ControlTheme>

			<!-- the splitter between the pictures: a tab stop, arrows move it, Enter or a double-click puts it back in the middle -->
			<ControlTheme x:Key="PictureSplitter" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
				<Setter Property="Background" Value="{DynamicResource SplitterBackground}" />
				<Style Selector="^:pointerover">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus">
					<Setter Property="Background" Value="{DynamicResource Accent}" />
				</Style>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>

	<!-- the spinner turns once a second while it carries the class, which the pane sets while the busy layer is shown -->
	<Style Selector="Path.spinning">
		<Style.Animations>
			<Animation Duration="0:0:1" IterationCount="INFINITE">
				<KeyFrame Cue="0%">
					<Setter Property="RotateTransform.Angle" Value="0" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="RotateTransform.Angle" Value="360" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>
</Styles>
