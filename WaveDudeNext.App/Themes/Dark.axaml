<!-- The dark colour table: upstream's Themes/Dark.xaml (Visual Studio dark values), key for key, so that every style of
     the port reads the same names as the WPF application. Light.axaml holds the same 92 keys. Styles read them with
     DynamicResource; the variant switch (View > Theme) swaps the whole table. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- window -->
	<SolidColorBrush x:Key="WindowBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="WindowForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="GrayText" Color="#FF999999" />
	<SolidColorBrush x:Key="ControlBorder" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="ControlShadow" Color="#71000000" />
	<SolidColorBrush x:Key="Accent" Color="#FF007ACC" />
	<!-- menus -->
	<SolidColorBrush x:Key="MenuBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="MenuForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="MenuPopupBackground" Color="#FF1B1B1C" />
	<SolidColorBrush x:Key="MenuPopupBorder" Color="#FF333337" />
	<SolidColorBrush x:Key="MenuItemHover" Color="#FF333334" />
	<SolidColorBrush x:Key="MenuItemHoverForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="MenuHeaderOpen" Color="#FF1B1B1C" />
	<SolidColorBrush x:Key="MenuSeparator" Color="#FF333337" />
	<SolidColorBrush x:Key="MenuGlyph" Color="#FF999999" />
	<SolidColorBrush x:Key="MenuGlyphHover" Color="#FF007ACC" />
	<!-- status bar -->
	<SolidColorBrush x:Key="StatusBarBackground" Color="#FF007ACC" />
	<SolidColorBrush x:Key="StatusBarForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="StatusBarWarnForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="StatusBarWarnBackground" Color="#FFCA5100" />
	<SolidColorBrush x:Key="StatusBarErrorForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="StatusBarErrorBackground" Color="#FFB4211D" />
	<!-- tool windows and their title bars -->
	<SolidColorBrush x:Key="ToolWindowBackground" Color="#FF252526" />
	<SolidColorBrush x:Key="ToolWindowBorder" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="TitleBarActiveBackground" Color="#FF007ACC" />
	<SolidColorBrush x:Key="TitleBarActiveForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="TitleBarInactiveBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="TitleBarInactiveForeground" Color="#FFD0D0D0" />
	<SolidColorBrush x:Key="TitleBarDragHandleActive" Color="#FF59A8DE" />
	<SolidColorBrush x:Key="TitleBarDragHandleInactive" Color="#FF46464A" />
	<SolidColorBrush x:Key="TitleBarButtonHoverActive" Color="#FF1C97EA" />
	<SolidColorBrush x:Key="TitleBarButtonHoverInactive" Color="#FF3E3E40" />
	<!-- tool tabs -->
	<SolidColorBrush x:Key="ToolTabBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="ToolTabForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="ToolTabSelectedBackground" Color="#FF252526" />
	<SolidColorBrush x:Key="ToolTabSelectedForeground" Color="#FF0097FB" />
	<SolidColorBrush x:Key="ToolTabHoverForeground" Color="#FF55AAFF" />
	<!-- document tabs and the document area -->
	<SolidColorBrush x:Key="DocTabBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="DocTabInactiveBackground" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="DocTabInactiveForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="DocTabSelectedBackground" Color="#FF007ACC" />
	<SolidColorBrush x:Key="DocTabSelectedForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="DocTabHotBackground" Color="#FF1C97EA" />
	<SolidColorBrush x:Key="DocTabHotForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="DocumentBackground" Color="#FF1E1E1E" />
	<!-- tree -->
	<SolidColorBrush x:Key="TreeViewBackground" Color="#FF252526" />
	<SolidColorBrush x:Key="TreeViewForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="TreeViewItemHover" Color="#FF3E3E40" />
	<SolidColorBrush x:Key="TreeViewItemSelected" Color="#FF3399FF" />
	<SolidColorBrush x:Key="TreeViewItemSelectedForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="TreeViewItemSelectedInactive" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="TreeViewItemSelectedInactiveForeground" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="TreeViewGlyph" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="TreeViewGlyphHover" Color="#FF007ACC" />
	<!-- scroll bars -->
	<SolidColorBrush x:Key="ScrollBarBackground" Color="#FF3E3E42" />
	<SolidColorBrush x:Key="ScrollBarThumb" Color="#FF686868" />
	<SolidColorBrush x:Key="ScrollBarThumbHover" Color="#FF9E9E9E" />
	<SolidColorBrush x:Key="ScrollBarThumbPressed" Color="#FFEFEBEF" />
	<SolidColorBrush x:Key="ScrollBarArrow" Color="#FF999999" />
	<SolidColorBrush x:Key="ScrollBarArrowHover" Color="#FF1C97EA" />
	<SolidColorBrush x:Key="ScrollBarArrowPressed" Color="#FF007ACC" />
	<!-- splitters and the docking drop indicators -->
	<SolidColorBrush x:Key="SplitterBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="DropIndicatorBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="DropIndicatorBorder" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="DropIndicatorGlyph" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="DropIndicatorHot" Color="#FF007ACC" />
	<SolidColorBrush x:Key="DropPreviewFill" Color="#60007ACC" />
	<!-- the timeline's ticks: visible but subtle on the bar's ScrollBarBackground (2026-11-10, the user's request) -->
	<SolidColorBrush x:Key="TimelineTick" Color="#FF78787F" />
	<SolidColorBrush x:Key="DropPreviewBorder" Color="#FF007ACC" />
	<!-- buttons and tooltips -->
	<SolidColorBrush x:Key="ButtonBackground" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="ButtonBorder" Color="#FF555558" />
	<SolidColorBrush x:Key="ButtonHover" Color="#FF4F4F56" />
	<SolidColorBrush x:Key="ButtonPressed" Color="#FF007ACC" />
	<SolidColorBrush x:Key="ToolTipBackground" Color="#FF2D2D30" />
	<SolidColorBrush x:Key="ToolTipBorder" Color="#FF3F3F46" />
	<!-- editors -->
	<SolidColorBrush x:Key="TextBoxBackground" Color="#FF333337" />
	<SolidColorBrush x:Key="TextBoxBorder" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="TextBoxHoverBorder" Color="#FF5A5A5E" />
	<SolidColorBrush x:Key="ComboBoxBackground" Color="#FF333337" />
	<SolidColorBrush x:Key="ComboBoxBorder" Color="#FF434346" />
	<SolidColorBrush x:Key="ComboBoxHover" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="ComboBoxListBackground" Color="#FF333337" />
	<SolidColorBrush x:Key="ComboBoxItemHover" Color="#FF3399FF" />
	<SolidColorBrush x:Key="ComboBoxItemHoverForeground" Color="#FFFFFFFF" />
	<SolidColorBrush x:Key="ComboBoxGlyph" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="CheckBoxBackground" Color="#FF333337" />
	<SolidColorBrush x:Key="CheckBoxBorder" Color="#FF6D6D70" />
	<!-- log levels in the Messages pane -->
	<SolidColorBrush x:Key="LogTrace" Color="#FF808080" />
	<SolidColorBrush x:Key="LogDebug" Color="#FF9B9B9B" />
	<SolidColorBrush x:Key="LogInfo" Color="#FFF1F1F1" />
	<SolidColorBrush x:Key="LogWarn" Color="#FFE5C07B" />
	<SolidColorBrush x:Key="LogError" Color="#FFF14C4C" />
	<SolidColorBrush x:Key="LogFatal" Color="#FFFF3B3B" />
</ResourceDictionary>
