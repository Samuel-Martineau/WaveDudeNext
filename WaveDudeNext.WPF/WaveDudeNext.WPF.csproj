<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Program.Main configures logging before the generated App.Main runs -->
    <StartupObject>WaveDudeNext.WPF.Program</StartupObject>
    <!-- executable icon (Explorer, taskbar); the window icon is the same file as a resource -->
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- DPI awareness per monitor (2026-11-02): the manifest says why -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- read by About and the file properties; the license text is LICENSE.md, the header of every source file names it.
         Authors and Company are the product's name (2026-10-26, the user's rule): .NET puts the company into folder names,
         and the author's name is nobody's business on a user's disk; the Copyright line names him -->
    <Authors>WaveDudeNext</Authors>
    <Company>WaveDudeNext</Company>
    <Copyright>Copyright (C) 2026 Alexander Gräf</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- the .editorconfig code-style rules are build warnings too: a file without the license header (IDE0073) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="App.ico" />
    <Resource Include="App.png" />
  </ItemGroup>

  <!-- LICENSE.md and MANUAL.md become the embedded FlowDocuments "License.xaml" (Help > About) and "Manual.xaml"
       (Help > Manual). The Build folder's C# is the build's converter, compiled by MSBuild, not part of the app -->
  <Import Project="Build\Documents.targets" />
  <ItemGroup>
    <Compile Remove="Build\**" />
    <None Include="Build\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <!-- WaveDudeNext.UI holds what no UI framework anchors (2026-11-06): the shipped examples are embedded there -->
  <ItemGroup>
    <ProjectReference Include="..\WaveDudeNext\WaveDudeNext.csproj" />
    <ProjectReference Include="..\WaveDudeNext.UI\WaveDudeNext.UI.csproj" />
  </ItemGroup>

  <!-- the published single EXE under the release's file name, WaveDudeNext-<version><suffix>.exe (2026-10-31, the user's
       request: the two publish profiles' files must not share a name). The profiles ask for it with NameReleaseFile and
       give the suffix; the assembly keeps its name, which the pack URIs of the resources carry -->
  <Target Name="NameReleaseFile" AfterTargets="Publish" Condition="'$(NameReleaseFile)' == 'true'">
    <PropertyGroup>
      <ReleaseFile>$(PublishDir)WaveDudeNext-$(Version)$(ReleaseFileSuffix).exe</ReleaseFile>
    </PropertyGroup>
    <Delete Files="$(ReleaseFile)" />
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(ReleaseFile)" />
    <Message Importance="high" Text="Release file: $(ReleaseFile)" />
  </Target>
  <!-- no symbol files beside the release EXE: the referenced library's pdb is not covered by CopyOutputSymbolsToPublishDirectory -->
  <Target Name="DropPublishedSymbols" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(NameReleaseFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
