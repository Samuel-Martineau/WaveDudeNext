<UserControl x:Class="WaveDudeNext.WPF.Views.LensPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands">

	<!-- the Mirror box's command: the name follows the flag (2026-10-29, the user's design) -->
	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:PartCommands.MirrorToggled}" Executed="OnMirrorToggled" />
	</UserControl.CommandBindings>

	<UserControl.Resources>
		<converters:LensEdgeConverter x:Key="EdgeThickness" />
		<!-- a mirror has no index, no coating and no absorption -->
		<Style x:Key="GlassOnly" TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type controls:NumberBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mirror}" Value="True">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="GlassOnlyCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EnumComboBox}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mirror}" Value="True">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="GlassOnlyCheck" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mirror}" Value="True">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!-- the Fresnel lens's zones row (2026-11-07): one row of the form laid out to its label column, given its content and
		     template only when the form says so, so a plain lens, which has no Zones, binds nothing. Inside the template the
		     string keys are referenced directly (2026-10-22) -->
		<DataTemplate x:Key="ZonesRow">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:FormPanel}}}" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource Label.FresnelLensPart.Zones}" />
				<controls:NumberBox Grid.Column="2" Text="{Binding Zones}" Minimum="1" Maximum="100" ToolTip="{DynamicResource Hint.FresnelLensPart.Zones}" AutomationProperties.AutomationId="PartZones" />
				<TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{DynamicResource Label.FresnelLensPart.Division}" />
				<ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:ZoneDivision}" SelectedItem="{Binding Division}"
				          ToolTip="{DynamicResource Hint.FresnelLensPart.Division}" AutomationProperties.AutomationId="PartZoneDivision" />
			</Grid>
		</DataTemplate>
		<!-- the Concave box is the lens's alone: a Fresnel lens's surfaces are hollowed by a negative radius (2026-11-07, the user's choice) -->
		<Style x:Key="ConcaveBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ZonesShown, RelativeSource={RelativeSource AncestorType={x:Type views:LensPartView}}}" Value="True">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="ZonesRowHost" TargetType="{x:Type ContentControl}">
			<Setter Property="Visibility" Value="Collapsed" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding ZonesShown, RelativeSource={RelativeSource AncestorType={x:Type views:LensPartView}}}" Value="True">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="Content" Value="{Binding}" />
					<Setter Property="ContentTemplate" Value="{StaticResource ZonesRow}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionMaterial}" />
			<controls:FormPanel>
				<!-- the box toggles the flag through its binding, then its command renames the part to match (Lens 1 to Mirror 1 and back) -->
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:LensPart.Mirror}"
				          IsChecked="{Binding Mirror}" ToolTip="{meta:Hint model:LensPart.Mirror}" AutomationProperties.AutomationId="PartMirror"
				          Command="{x:Static commands:PartCommands.MirrorToggled}" CommandParameter="{Binding}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.RefractiveIndex}" />
				<controls:NumberBox Style="{StaticResource GlassOnly}" Text="{Binding RefractiveIndex}" Minimum="1" Maximum="2.55" Increment="0.01"
				                    ToolTip="{meta:Hint model:LensPart.RefractiveIndex}" AutomationProperties.AutomationId="PartIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.Coating}" />
				<controls:NumberBox Style="{StaticResource GlassOnly}" Text="{Binding Coating}" Minimum="0" Maximum="50"
				                    ToolTip="{meta:Hint model:LensPart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:CoatedPart.CoatingProfile}" />
				<ComboBox Style="{StaticResource GlassOnlyCombo}" ItemsSource="{meta:EnumValues model:CoatingProfile}" SelectedItem="{Binding CoatingProfile}"
				          ToolTip="{meta:Hint model:CoatedPart.CoatingProfile}" AutomationProperties.AutomationId="PartCoatingProfile" />

				<!-- the faces: the first surface is the front, the second the back, the rim the sides (2026-10-29) -->
				<CheckBox controls:FormPanel.FullWidth="True" Style="{StaticResource GlassOnlyCheck}" Content="{meta:Label model:CoatedPart.FrontCoated}"
				          IsChecked="{Binding FrontCoated}" ToolTip="{meta:Hint model:CoatedPart.FrontCoated}" AutomationProperties.AutomationId="PartFrontCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Style="{StaticResource GlassOnlyCheck}" Content="{meta:Label model:CoatedPart.BackCoated}"
				          IsChecked="{Binding BackCoated}" ToolTip="{meta:Hint model:CoatedPart.BackCoated}" AutomationProperties.AutomationId="PartBackCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Style="{StaticResource GlassOnlyCheck}" Content="{meta:Label model:CoatedPart.SidesCoated}"
				          IsChecked="{Binding SidesCoated}" ToolTip="{meta:Hint model:CoatedPart.SidesCoated}" AutomationProperties.AutomationId="PartSidesCoated" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.Absorption}" />
				<controls:NumberBox Style="{StaticResource GlassOnly}" Text="{Binding Absorption}" Minimum="0" Maximum="255" Increment="5"
				                    ToolTip="{meta:Hint model:LensPart.Absorption}" AutomationProperties.AutomationId="PartAbsorption" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.AbsorptionRamp}" />
				<controls:NumberBox Style="{StaticResource GlassOnly}" Text="{Binding AbsorptionRamp}" Minimum="1" Maximum="400" Increment="5"
				                    ToolTip="{meta:Hint model:LensPart.AbsorptionRamp}" AutomationProperties.AutomationId="PartAbsorptionRamp" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.Diameter}" />
				<controls:NumberBox Text="{Binding Diameter}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:LensPart.Diameter}" AutomationProperties.AutomationId="PartDiameter" />

				<!-- the lens's state in one box: on for a diverging lens; ticking it flips both radii -->
				<CheckBox controls:FormPanel.FullWidth="True" Style="{StaticResource ConcaveBox}" Content="{meta:Label model:LensPart.IsConcave}"
				          IsChecked="{Binding IsConcave}" ToolTip="{meta:Hint model:LensPart.IsConcave}" AutomationProperties.AutomationId="PartConcave" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.R1}" />
				<controls:NumberBox Text="{Binding R1}" Increment="10" ToolTip="{meta:Hint model:LensPart.R1}" AutomationProperties.AutomationId="PartR1" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.R2}" />
				<controls:NumberBox Text="{Binding R2}" Increment="10" ToolTip="{meta:Hint model:LensPart.R2}" AutomationProperties.AutomationId="PartR2" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:LensPart.Thickness}" />
				<controls:NumberBox Text="{Binding Thickness}" Minimum="1" ToolTip="{meta:Hint model:LensPart.Thickness}" AutomationProperties.AutomationId="PartThickness" />

				<ContentControl controls:FormPanel.FullWidth="True" Style="{StaticResource ZonesRowHost}" />

				<!-- read-only: what the radii leave at the rim; 0 when the surfaces meet there (with zones, the outer zone's sags) -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelEdgeThickness}" />
				<TextBlock Style="{StaticResource FormReadout}" ToolTip="{DynamicResource TipEdgeThickness}" AutomationProperties.AutomationId="PartEdgeThickness">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource EdgeThickness}">
							<Binding Path="Diameter" />
							<Binding Path="Thickness" />
							<Binding Path="R1" />
							<Binding Path="R2" />
							<Binding Path="ZoneCount" />
							<Binding Path="ZoneDivision" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
