<UserControl x:Class="WaveDudeNext.WPF.Views.SimpleGratingPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the dots' material: mirror or glass, index, absorption; no coating rows, the dots take no band -->
			<views:ShapeMaterialView CoatingShown="False" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionLattice}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:SimpleGratingPart.Columns}" />
				<controls:NumberBox Text="{Binding Columns}" Minimum="1" ToolTip="{meta:Hint model:SimpleGratingPart.Columns}" AutomationProperties.AutomationId="PartColumns" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:SimpleGratingPart.Rows}" />
				<controls:NumberBox Text="{Binding Rows}" Minimum="1" ToolTip="{meta:Hint model:SimpleGratingPart.Rows}" AutomationProperties.AutomationId="PartRows" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:SimpleGratingPart.ColumnSpacing}" />
				<controls:NumberBox Text="{Binding ColumnSpacing}" Minimum="2" ToolTip="{meta:Hint model:SimpleGratingPart.ColumnSpacing}" AutomationProperties.AutomationId="PartColumnSpacing" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:SimpleGratingPart.RowSpacing}" />
				<controls:NumberBox Text="{Binding RowSpacing}" Minimum="2" ToolTip="{meta:Hint model:SimpleGratingPart.RowSpacing}" AutomationProperties.AutomationId="PartRowSpacing" />

				<!-- at most half the smaller spacing: the box's top follows the spacings -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:SimpleGratingPart.Diameter}" />
				<controls:NumberBox Text="{Binding Diameter}" Minimum="1" Maximum="{Binding MaxDiameter}" ToolTip="{meta:Hint model:SimpleGratingPart.Diameter}" AutomationProperties.AutomationId="PartDiameter" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
