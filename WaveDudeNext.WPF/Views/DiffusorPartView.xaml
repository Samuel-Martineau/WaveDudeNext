<UserControl x:Class="WaveDudeNext.WPF.Views.DiffusorPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:PixelsConverter x:Key="Pixels" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:DiffusorPart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:DiffusorPart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:DiffusorPart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:DiffusorPart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>

			<!-- the roughness of the front face: a spectrum of ripples about a centre wavelength, their sum the face -->
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionRoughness}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:DiffusorPart.CenterWavelength}" />
				<controls:NumberBox Text="{Binding CenterWavelength}" Minimum="2" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:DiffusorPart.CenterWavelength}" AutomationProperties.AutomationId="PartCenterWavelength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:DiffusorPart.Amplitude}" />
				<controls:NumberBox Text="{Binding Amplitude}" Minimum="0" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:DiffusorPart.Amplitude}" AutomationProperties.AutomationId="PartAmplitude" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:DiffusorPart.Sigma}" />
				<controls:NumberBox Text="{Binding Sigma}" Minimum="0" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:DiffusorPart.Sigma}" AutomationProperties.AutomationId="PartSigma" />

				<!-- read-only: what the ripples add up to, and how many there are -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelProfileHeight}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding ProfileHeight, Converter={StaticResource Pixels}}" ToolTip="{DynamicResource TipProfileHeight}" AutomationProperties.AutomationId="PartProfileHeight" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelComponentCount}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding ComponentCount}" ToolTip="{DynamicResource TipComponentCount}" AutomationProperties.AutomationId="PartComponentCount" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
