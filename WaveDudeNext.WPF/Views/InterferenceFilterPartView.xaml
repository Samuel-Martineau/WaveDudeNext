<UserControl x:Class="WaveDudeNext.WPF.Views.InterferenceFilterPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:PixelsConverter x:Key="Pixels" />
		<converters:OrdinalConverter x:Key="Ordinal" />
	</UserControl.Resources>

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:PartCommands.AddPoint}" CanExecute="CanAddLayer" Executed="OnAddLayer" />
		<CommandBinding Command="{x:Static commands:PartCommands.RemovePoint}" CanExecute="CanEditLayer" Executed="OnRemoveLayer" />
		<CommandBinding Command="{x:Static commands:PartCommands.MoveRowUp}" CanExecute="CanMoveLayerUp" Executed="OnMoveLayerUp" />
		<CommandBinding Command="{x:Static commands:PartCommands.MoveRowDown}" CanExecute="CanMoveLayerDown" Executed="OnMoveLayerDown" />
		<CommandBinding Command="{x:Static commands:PartCommands.RemoveAllRows}" CanExecute="CanRemoveAllLayers" Executed="OnRemoveAllLayers" />
	</UserControl.CommandBindings>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the plate's material; its coating on the back alone, the front carrying the layers -->
			<views:ShapeMaterialView BackOnly="True" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:InterferenceFilterPart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:InterferenceFilterPart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:InterferenceFilterPart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:InterferenceFilterPart.Width}" AutomationProperties.AutomationId="PartWidth" />

				<!-- read-only: the layers' thicknesses added up -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelStackThickness}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding StackThickness, Converter={StaticResource Pixels}}" ToolTip="{DynamicResource TipStackThickness}" AutomationProperties.AutomationId="PartStackThickness" />
			</controls:FormPanel>

			<!-- the layers, the outermost first: a row each with a grip to drag it by, its number, thickness and index, up, down
			     and remove; an add button below. Inside the template the string keys are referenced directly (a template rejects
			     the resource reference the meta extensions wrap, 2026-10-22) -->
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionLayers}" />
			<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource GrayText}" TextWrapping="Wrap" Text="{DynamicResource HintFilterLayers}" />
			<Grid Margin="0,0,0,2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="66" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="2" Style="{StaticResource FormLabel}" Text="{meta:Label model:FilterLayer.Thickness}" Margin="2,0" />
				<TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="{meta:Label model:FilterLayer.RefractiveIndex}" Margin="2,0" />
			</Grid>
			<ItemsControl x:Name="list" ItemsSource="{Binding Layers}" Focusable="False" AlternationCount="100000" AllowDrop="True"
			              PreviewDragOver="OnLayerDragOver" PreviewDrop="OnLayerDrop" AutomationProperties.AutomationId="PartLayers">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0,0,0,4" Background="Transparent">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="14" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="66" />
							</Grid.ColumnDefinitions>
							<!-- the grip: a drag by it moves the row through the list -->
							<Border Grid.Column="0" Background="Transparent" Cursor="SizeNS" ToolTip="{DynamicResource TipDragLayer}"
							        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp">
								<Path Data="{StaticResource GripGeometry}" Stroke="{DynamicResource GrayText}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<TextBlock Grid.Column="1" Style="{StaticResource FormLabel}" Foreground="{DynamicResource GrayText}"
							           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, Converter={StaticResource Ordinal}}" />
							<controls:NumberBox Grid.Column="2" Margin="0,0,2,0" Text="{Binding Thickness}" Minimum="0" Maximum="1000" DragStep="0.1" Decimals="2"
							                    ToolTip="{DynamicResource Hint.FilterLayer.Thickness}" AutomationProperties.Name="{DynamicResource Label.FilterLayer.Thickness}" />
							<controls:NumberBox Grid.Column="3" Margin="2,0,0,0" Text="{Binding RefractiveIndex}" Minimum="1" Maximum="2.55" Increment="0.01"
							                    ToolTip="{DynamicResource Hint.FilterLayer.RefractiveIndex}" AutomationProperties.Name="{DynamicResource Label.FilterLayer.RefractiveIndex}" />
							<StackPanel Grid.Column="4" Orientation="Horizontal">
								<Button Style="{StaticResource RowGlyphButton}" Content="{StaticResource ChevronUpGeometry}" Tag="Up"
								        ToolTip="{DynamicResource TipLayerUp}" AutomationProperties.Name="{DynamicResource TipLayerUp}"
								        Command="{x:Static commands:PartCommands.MoveRowUp}" CommandParameter="{Binding}" />
								<Button Style="{StaticResource RowGlyphButton}" Content="{StaticResource ChevronDownGeometry}" Tag="Down"
								        ToolTip="{DynamicResource TipLayerDown}" AutomationProperties.Name="{DynamicResource TipLayerDown}"
								        Command="{x:Static commands:PartCommands.MoveRowDown}" CommandParameter="{Binding}" />
								<Button Style="{StaticResource RemovePointButton}" ToolTip="{DynamicResource TipRemoveLayer}" AutomationProperties.Name="{DynamicResource TipRemoveLayer}"
								        Command="{x:Static commands:PartCommands.RemovePoint}" CommandParameter="{Binding}" />
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
				<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddLayer}" ToolTip="{DynamicResource TipAddLayer}"
				        Command="{x:Static commands:PartCommands.AddPoint}" AutomationProperties.AutomationId="PartAddLayer" />
				<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonRemoveAllLayers}" ToolTip="{DynamicResource TipRemoveAllLayers}"
				        Command="{x:Static commands:PartCommands.RemoveAllRows}" AutomationProperties.AutomationId="PartRemoveAllLayers" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
