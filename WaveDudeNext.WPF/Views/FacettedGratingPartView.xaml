<UserControl x:Class="WaveDudeNext.WPF.Views.FacettedGratingPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the plate's material; its coating on the back alone, the front carrying the facets -->
			<views:ShapeMaterialView BackOnly="True" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FacettedGratingPart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:FacettedGratingPart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FacettedGratingPart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:FacettedGratingPart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>

			<!-- the relief of the front face: a pattern repeated every pitch, so high either side of the mean -->
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionFacets}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FacettedGratingPart.Pattern}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:FacetPattern}" SelectedItem="{Binding Pattern}"
				          ToolTip="{meta:Hint model:FacettedGratingPart.Pattern}" AutomationProperties.AutomationId="PartPattern" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FacettedGratingPart.Pitch}" />
				<controls:NumberBox Text="{Binding Pitch}" Minimum="2" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:FacettedGratingPart.Pitch}" AutomationProperties.AutomationId="PartPitch" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FacettedGratingPart.Amplitude}" />
				<controls:NumberBox Text="{Binding Amplitude}" Minimum="0" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:FacettedGratingPart.Amplitude}" AutomationProperties.AutomationId="PartAmplitude" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
