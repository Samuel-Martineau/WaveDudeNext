<UserControl x:Class="WaveDudeNext.WPF.Views.MetaLensPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:PixelsConverter x:Key="Pixels" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the plate's material; the band on the pattern's tops (front) and the plate's back, no sides -->
			<views:ShapeMaterialView SidesHidden="True" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:MetaSurfacePart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:MetaSurfacePart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>

			<!-- the lens: the wavelength it is cut for, the focus, and which way the fill runs -->
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionLens}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.DesignFrequency}" />
				<controls:NumberBox Text="{Binding DesignFrequency}" Minimum="1" Maximum="255" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:MetaSurfacePart.DesignFrequency}" AutomationProperties.AutomationId="PartDesignFrequency" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelWavelength}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding Wavelength, Converter={StaticResource Pixels}}" ToolTip="{DynamicResource TipGateWavelength}" AutomationProperties.AutomationId="PartWavelength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaLensPart.FocalLength}" />
				<controls:NumberBox Text="{Binding FocalLength}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:MetaLensPart.FocalLength}" AutomationProperties.AutomationId="PartFocalLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaLensPart.LensType}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:MetaLensType}" SelectedItem="{Binding LensType}"
				          ToolTip="{meta:Hint model:MetaLensPart.LensType}" AutomationProperties.AutomationId="PartLensType" />

				<!-- read-only: the zones, each a turn of phase, from the centre to the rim -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelMetaZones}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding ZoneCount}" ToolTip="{DynamicResource TipMetaZones}" AutomationProperties.AutomationId="PartZoneCount" />
			</controls:FormPanel>

			<!-- the pattern: the ridges' index, cell and height, and the height a full turn needs -->
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionPattern}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.PatternIndex}" />
				<controls:NumberBox Text="{Binding PatternIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:MetaSurfacePart.PatternIndex}" AutomationProperties.AutomationId="PartPatternIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.Pitch}" />
				<controls:NumberBox Text="{Binding Pitch}" Minimum="1" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:MetaSurfacePart.Pitch}" AutomationProperties.AutomationId="PartPitch" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:MetaSurfacePart.Height}" />
				<controls:NumberBox Text="{Binding Height}" Minimum="1" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:MetaSurfacePart.Height}" AutomationProperties.AutomationId="PartHeight" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelFullTurnHeight}" />
				<TextBlock Style="{StaticResource FormReadout}" Text="{Binding FullTurnHeight, Converter={StaticResource Pixels}}" ToolTip="{DynamicResource TipFullTurnHeight}" AutomationProperties.AutomationId="PartFullTurnHeight" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
